# Shopping List Server - Docker Environment Variables
# Copy this file to .env and fill in values before running docker compose.

# --- Database ---
DB_PASSWORD=CHANGE_ME_secure_db_password
DB_ROOT_PASSWORD=CHANGE_ME_secure_root_password
DB_NAME=shoppinglistserver
DB_USER=ShoppingListDBUser

# --- JWT ---
JWT_SECRET=CHANGE_ME_random_64_char_string

# --- Email ---
NOREPLY_EMAIL_PASSWORD=CHANGE_ME_email_password

# --- Firebase (optional, set to false to disable) ---
USE_FIREBASE=false
# Path inside the container to the Firebase Admin SDK JSON key
GOOGLE_APPLICATION_CREDENTIALS=/app/auth/firebase-adminsdk.json

# --- Apple Sign-In (optional) ---
APPLE_CLIENT_ID=GenericListApp.iOS.app
APPLE_SIGN_IN_KEY_ID=REPLACE
APPLE_TEAM_ID=REPLACE

# --- Facebook (optional) ---
FACEBOOK_APP_ID=REPLACE

# --- TLS ---
# Set to True when TLS certificates are mounted
USE_HTTPS_REDIRECT=False
