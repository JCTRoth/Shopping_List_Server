{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "k3sTag",
            "type": "promptString",
            "description": "Image tag",
            "default": "latest"
        }
    ],
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/WebApi.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "debug: stop container",
            "type": "process",
            "command": "docker",
            "args": ["compose", "stop", "shoppinglistserver"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "debug: build and stop container",
            "dependsOn": ["build", "debug: stop container"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "database: start Adminer",
            "type": "process",
            "command": "docker",
            "args": ["compose", "up", "-d", "--no-deps", "adminer"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            // Run the API from source on http://localhost:5677. The Docker API
            // container is stopped first because it publishes the same port;
            // PostgreSQL and Adminer keep running. --no-launch-profile keeps
            // the URLs from Program.cs instead of launchSettings.json.
            "label": "local: start",
            "type": "shell",
            "command": "docker compose stop shoppinglistserver && docker compose up -d --no-deps db adminer && dotnet run --project WebApi.csproj --no-launch-profile",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ASPNETCORE_ENVIRONMENT": "Development",
                    "DB_PASSWORD": "sl_dev_pw_2026"
                }
            },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "local" }
        },
        {
            // Build & push the Docker image for linux/amd64.
            "label": "k3s: build-push",
            "type": "shell",
            "command": "docker buildx build --platform linux/amd64 --tag ghcr.io/danielroth1/shoppinglist-api:${input:k3sTag} --push .",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "k3s" }
        },
        {
            // Deploy: create namespace + pull secret + application secret + apply manifests + wait for rollout.
            "label": "k3s: deploy",
            "type": "shell",
            "command": "bash scripts/deploy.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "TAG": "${input:k3sTag}"
                }
            },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "k3s" }
        },
        {
            // Build, push, and deploy in one step.
            "label": "k3s: build-push-deploy",
            "dependsOn": ["k3s: build-push", "k3s: deploy"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "k3s" }
        },
        {
            // Show pod, ingress, service, and certificate status.
            "label": "k3s: status",
            "type": "shell",
            "command": "KUBECONFIG=~/.kube/k3s-erp.yaml kubectl get pods,ingress,svc,certificate -n shoppinglist-api -o wide",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "group": "k3s" }
        },
        {
            // Stream logs from the deployment.
            "label": "k3s: logs",
            "type": "shell",
            "command": "KUBECONFIG=~/.kube/k3s-erp.yaml kubectl logs -n shoppinglist-api -f deploy/shoppinglist-api",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "k3s" }
        }
    ]
}