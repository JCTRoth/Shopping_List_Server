# k3s deployment settings for the ShoppingListServer API (api.shopping-now.net)

# SSH target of the k3s server, e.g. user@1.2.3.4
K3S_SERVER="<username>@<ip>"
K3S_SSH_PORT="7878"

# GitHub user/org that owns the container image (ghcr.io/<YOURUSER>/shoppinglist-api)
YOURUSER=""

# GitHub PAT with read:packages + write:packages
GHCR_TOKEN="ghp_yourTokenHere"

# ── Optional application secrets ───────────────────────────────────────────
# Leave these empty on the first deploy: scripts/deploy.sh generates the JWT
# key and the database password, and reuses them on every later deploy.
JWT_SECRET=""
DB_PASSWORD=""
MAIL_PASSWORD=""

# Object-storage credentials shared by MinIO and the API. Leave empty to have
# scripts/deploy.sh generate them once and reuse them on later deploys.
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
